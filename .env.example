# Copy this file to .env and fill in your values. Never commit .env.

# Anthropic (Claude) — required for smart planning
ANTHROPIC_API_KEY=sk-ant-...

# Model selection (defaults to claude-sonnet-4-5 if unset)
AIVIDEO_MODEL=claude-sonnet-4-5

# TTS engine: edge_tts | kokoro | espeak  (never use mock in production)
AIVIDEO_TTS_ENGINE=edge_tts

# Edge TTS voice (edge_tts engine):
#   en-US-AriaNeural   warm American female (default)
#   en-US-GuyNeural    natural American male
#   en-US-JennyNeural  friendly American female
#   en-GB-SoniaNeural  British female
#   en-GB-RyanNeural   British male
AIVIDEO_TTS_VOICE=en-US-AriaNeural

# Kokoro voice (kokoro engine):
#   af_heart | af_sky | am_michael | am_adam | bf_emma | bm_george
# AIVIDEO_TTS_VOICE=af_heart

# Max cost per job in USD (aborts cleanly when exceeded)
MAX_JOB_COST_USD=0.50

# Set to 1 in CI to return fixtures instead of calling the API
MOCK_LLM=0

# Server port (default 8080; port 8000 is used by other services)
PORT=8080

# SQLite DB path (absolute or relative to project root)
DB_PATH=output/jobs.db

# Output directory for jobs
JOBS_DIR=output/jobs
